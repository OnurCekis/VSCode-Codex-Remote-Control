{
  "name": "vscode-codex-remote-control",
  "version": "1.2.0",
  "private": true,
  "description": "Remote control for an isolated VS Code Codex session on macOS, Telegram, and Android",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cross-platform": "npm run typecheck && vitest run && python -m unittest discover -s tests -p \"test_*.py\"",
    "test:watch": "vitest",
    "probe": "tsx apps/ipc-probe/src/cli.ts",
    "protocol:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-protocol.ps1",
    "launcher:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1",
    "smoke:stdio": "tsx apps/ipc-probe/src/app-server-smoke.ts stdio",
    "phase0.5:transport": "tsx apps/ipc-probe/src/phase-0-5-integration.ts transport",
    "phase0.5:approval": "tsx apps/ipc-probe/src/phase-0-5-integration.ts approval",
    "phase0.6:integration": "tsx apps/ipc-probe/src/phase-0-6-integration.ts",
    "phase0.7:launcher-smoke": "tsx apps/ipc-probe/src/phase-0-7-launcher-smoke.ts",
    "phase0.7:vscode": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-vscode-profile.ps1",
    "phase2.2:cwd": "tsx apps/ipc-probe/src/phase-2-2-cwd-experiment.ts",
    "phase2.2.1:live-core": "tsx apps/ipc-probe/src/phase-2-2-1-live-core-integration.ts",
    "phase2.3:writer-model": "tsx apps/ipc-probe/src/phase-2-3-writer-model-integration.ts",
    "phase3:copresence": "tsx apps/ipc-probe/src/phase-3-browser-copresence.ts",
    "phase3:browser:install": "playwright install chromium",
    "phase3:vscode-browser": "tsx apps/ipc-probe/src/phase-3-vscode-browser-integration.ts",
    "phase3:vscode-browser:manual": "tsx apps/ipc-probe/src/phase-3-vscode-browser-integration.ts --manual-owner",
    "phase2.3:late-join-protocol": "tsx apps/ipc-probe/src/phase-2-3-late-join-protocol.ts",
    "phase2.3:late-join-core": "tsx apps/ipc-probe/src/phase-2-3-late-join-core-integration.ts",
    "phase1:host": "tsx apps/pocket-cli/src/vscode-host.ts",
    "phase1:host:macos": "tsx apps/pocket-cli/src/macos-host.ts",
    "phase1:integration": "tsx apps/pocket-cli/src/phase-1-vscode-integration.ts",
    "phase1:shared-topology": "tsx apps/pocket-cli/src/production-shared-topology-integration.ts",
    "phase1:multi-workspace": "tsx apps/pocket-cli/src/production-multi-workspace-integration.ts",
    "pocket": "tsx apps/pocket-cli/src/cli.ts",
    "pocket-code": "tsx apps/pocket-cli/src/pocket-code.ts",
    "pocket-code:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-pocket-code.ps1",
    "pocket-code:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-pocket-code.ps1",
    "telegram": "npx --yes --package node@24.19.0 --call \"node --env-file-if-exists=.env --import tsx apps/telegram-bot/src/main.ts\"",
    "telegram:config-check": "npx --yes --package node@24.19.0 --call \"node --env-file-if-exists=.env --import tsx apps/telegram-bot/src/config-check.ts\"",
    "ui:bridge": "node --import tsx apps/pocket-ui-bridge/src/main.ts",
    "ui:setup": "node --import tsx apps/pocket-ui-bridge/src/setup-main.ts",
    "phase2:telegram:e2e": "npx --yes --package node@24.19.0 --call \"node --env-file-if-exists=.env --import tsx apps/telegram-bot/src/real-telegram-integration.ts\"",
    "phase2:vscode": "tsx apps/telegram-bot/src/phase-2-vscode-integration.ts",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\"",
    "supervisor:start": "tsx apps/ipc-probe/src/native-supervisor-cli.ts",
    "vscode:isolated": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-vscode-profile.ps1"
  },
  "dependencies": {
    "ws": "8.18.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.79",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "deno": "2.9.6",
    "playwright": "1.63.0-alpha-2026-08-05",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
